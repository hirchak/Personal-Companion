{
  "$defs": {
    "SecurityCheck": {
      "additionalProperties": false,
      "properties": {
        "gate": {
          "title": "Gate",
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "OPTIONAL_UNAVAILABLE",
            "NOT_RUN",
            "BLOCKED_BY_PERMISSION",
            "INCOMPATIBLE",
            "SECURITY_REQUIREMENT_NOT_MET"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "gate",
        "status"
      ],
      "title": "SecurityCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": 1,
      "title": "Format",
      "type": "integer"
    },
    "scope": {
      "const": "PRIVATE_LOCAL_SECURITY_TESTED_MAC_ONLY",
      "title": "Scope",
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "OPTIONAL_UNAVAILABLE",
        "NOT_RUN",
        "BLOCKED_BY_PERMISSION",
        "INCOMPATIBLE",
        "SECURITY_REQUIREMENT_NOT_MET"
      ],
      "title": "Status",
      "type": "string"
    },
    "release_id": {
      "title": "Release Id",
      "type": "string"
    },
    "manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Hash",
      "type": "string"
    },
    "runtime_input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Input Hash",
      "type": "string"
    },
    "os": {
      "title": "Os",
      "type": "string"
    },
    "architecture": {
      "title": "Architecture",
      "type": "string"
    },
    "python": {
      "title": "Python",
      "type": "string"
    },
    "root_kind": {
      "const": "PRIVATE_LOCAL",
      "title": "Root Kind",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/SecurityCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "storage_protection": {
      "enum": [
        "VERIFIED_FILEVAULT_VOLUME",
        "UNVERIFIED"
      ],
      "title": "Storage Protection",
      "type": "string"
    },
    "backup_protection": {
      "enum": [
        "VERIFIED_FILEVAULT_VOLUME",
        "UNVERIFIED"
      ],
      "title": "Backup Protection",
      "type": "string"
    },
    "application_level_database_encryption": {
      "const": "NOT_IMPLEMENTED",
      "title": "Application Level Database Encryption",
      "type": "string"
    },
    "application_level_backup_encryption": {
      "const": "NOT_IMPLEMENTED",
      "title": "Application Level Backup Encryption",
      "type": "string"
    },
    "runtime_profile": {
      "additionalProperties": true,
      "title": "Runtime Profile",
      "type": "object",
      "const": {
        "profile_id": "MAC_PRIVATE_LOCAL_CORE_V1",
        "profile_version": 1,
        "journal": "ON",
        "creative": "ON",
        "local_search": "ON",
        "backup_restore": "ON",
        "explicit_local_export": "ON",
        "private_ai": "OFF",
        "conversation_inference": "OFF",
        "specialists": "OFF",
        "clinical_active": 0,
        "health_to_ai": "OFF",
        "health_bridge": "OFF",
        "human_voice_asr": "OFF",
        "cloud_asr": "NONE",
        "external_embeddings": "OFF",
        "phone": "OFF",
        "cloud_sync": "NONE",
        "telemetry": "NONE",
        "publication": "NONE",
        "automatic_external_sharing": "NONE",
        "provider_fallback": "NONE"
      }
    }
  },
  "required": [
    "format",
    "scope",
    "status",
    "release_id",
    "manifest_hash",
    "runtime_input_hash",
    "os",
    "architecture",
    "python",
    "root_kind",
    "checks",
    "storage_protection",
    "backup_protection",
    "application_level_database_encryption",
    "application_level_backup_encryption",
    "runtime_profile"
  ],
  "title": "PrivatePreflight",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Structural schema with exact profile. Raw type/native-state/cross-field checks additionally enforced by Python validator and negative tests."
}
