          "type": "object"
        },
        "external_review_status": {
          "minLength": 1,
          "title": "External Review Status",
          "type": "string"
        },
        "actual_local_verification": {
          "const": "MAPPING_ONLY_NOT_PRIMARY_RECHECK",
          "title": "Actual Local Verification",
          "type": "string"
        },
        "evidence_status": {
          "enum": [
            "SCOPED_EXTERNAL_CHECK",
            "NEEDS_VERIFICATION"
          ],
          "title": "Evidence Status",
          "type": "string"
        },
        "applicability": {
          "const": "NO_AUTOMATIC_TRANSFER_TO_APP",
          "title": "Applicability",
          "type": "string"
        },
        "rights_status": {
          "const": "NOT_REVIEWED_FOR_EXACT_USE",
          "title": "Rights Status",
          "type": "string"
        },
        "content_status": {
          "const": "NOT_REVIEWED",
          "title": "Content Status",
          "type": "string"
        },
        "scientific_validation": {
          "const": false,
          "title": "Scientific Validation",
          "type": "boolean"
        }
