        "id",
        "finding_id",
        "packet_ids",
        "raw_claimed_status",
        "raw_position",
        "source_ids",
        "source_bindings",
        "external_review_status",
        "actual_local_verification",
        "evidence_status",
        "applicability",
        "rights_status",
        "content_status",
        "scientific_validation"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Correction": {
