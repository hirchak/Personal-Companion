          "pattern": "^RG-(?:0[1-9]|1[0-9]|2[0-7])$",
          "title": "Finding Id",
          "type": "string"
        },
        "packet_ids": {
          "items": {
            "pattern": "^R(?:0[1-9]|1[0-6])$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Packet Ids",
          "type": "array"
        },
        "raw_claimed_status": {
          "minLength": 1,
          "title": "Raw Claimed Status",
          "type": "string"
        },
        "raw_position": {
          "minLength": 1,
          "title": "Raw Position",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "pattern": "^gate:S(?:0[1-9]|1[0-6])$",
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "source_bindings": {
          "patternProperties": {
            "^gate:S(?:0[1-9]|1[0-6])$": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
