{
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^R(?:0[1-9]|1[0-6])$",
      "title": "Id",
      "type": "string"
    },
    "filename": {
      "minLength": 1,
      "title": "Filename",
      "type": "string"
    },
    "bytes": {
      "exclusiveMinimum": 0,
      "title": "Bytes",
      "type": "integer"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "raw_claimed_status": {
      "minLength": 1,
      "title": "Raw Claimed Status",
      "type": "string"
    },
    "external_receipt": {
      "const": "RECEIVED_AND_EXTRACTED_IN_CHATGPT",
      "title": "External Receipt",
      "type": "string"
    },
    "local_receipt": {
      "const": "MANIFEST_ONLY_NOT_LOCALLY_RECEIVED",
      "title": "Local Receipt",
      "type": "string"
    },
    "local_bytes_verified": {
      "const": false,
      "title": "Local Bytes Verified",
      "type": "boolean"
    },
    "external_review_status": {
      "const": "SCOPE_AND_CONSISTENCY_SCREENED",
      "title": "External Review Status",
      "type": "string"
    },
    "full_evidence_review": {
      "const": "NOT_COMPLETED",
      "title": "Full Evidence Review",
      "type": "string"
    },
    "rights_status": {
      "const": "NOT_CLEARED_AS_A_WHOLE",
      "title": "Rights Status",
      "type": "string"
    },
    "content_status": {
      "const": "NOT_APPROVED",
      "title": "Content Status",
      "type": "string"
    },
    "finding_ids": {
      "items": {
        "pattern": "^RG-(?:0[1-9]|1[0-9]|2[0-7])$",
        "type": "string"
      },
      "title": "Finding Ids",
      "type": "array"
    }
  },
  "required": [
    "id",
    "filename",
    "bytes",
    "sha256",
    "raw_claimed_status",
    "external_receipt",
    "local_receipt",
    "local_bytes_verified",
    "external_review_status",
    "full_evidence_review",
    "rights_status",
    "content_status",
    "finding_ids"
  ],
  "title": "Receipt",
  "type": "object"
}
