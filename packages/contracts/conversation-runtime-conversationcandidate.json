{
  "$defs": {
    "ClosureCandidate": {
      "additionalProperties": false,
      "properties": {
        "discussed": {
          "items": {
            "maxLength": 600,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 4,
          "title": "Discussed",
          "type": "array"
        },
        "clearer": {
          "maxLength": 1000,
          "title": "Clearer",
          "type": "string"
        },
        "unresolved": {
          "maxLength": 600,
          "title": "Unresolved",
          "type": "string"
        },
        "possible_steps": {
          "items": {
            "maxLength": 600,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 3,
          "title": "Possible Steps",
          "type": "array"
        }
      },
      "required": [
        "discussed",
        "clearer",
        "unresolved",
        "possible_steps"
      ],
      "title": "ClosureCandidate",
      "type": "object"
    },
    "MapCandidateItem": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "OBSERVATION",
            "FEELING",
            "ACTION",
            "HYPOTHESIS",
            "QUESTION",
            "CHANGE",
            "OPTION",
            "TAKEAWAY",
            "UNRESOLVED"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "description": "For USER_STATED only: exact unchanged substring of the CURRENT user message, not a paraphrase or interpretation. For paraphrases choose MODEL_DERIVED_SUMMARY.",
          "maxLength": 800,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "provenance": {
          "description": "HYPOTHESIS kind requires MODEL_HYPOTHESIS; all other kinds cannot use MODEL_HYPOTHESIS. USER_STATED requires an exact current-user quote and OBSERVATION/FEELING/ACTION kind. Prefer MODEL_DERIVED_SUMMARY for every paraphrase. Never USER_CONFIRMED.",
          "enum": [
            "USER_STATED",
            "MODEL_HYPOTHESIS",
            "MODEL_DERIVED_SUMMARY"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "source_refs": {
          "description": "Exact supplied sNN aliases only. USER_STATED must cite only current_message_ref; historical roles may be unknown. Other items cite their actual supporting supplied context.",
          "items": {
            "pattern": "^s[0-9]{1,2}$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "text",
        "provenance",
        "source_refs"
      ],
      "title": "MapCandidateItem",
      "type": "object"
    },
    "WorkingMapCandidate": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/MapCandidateItem"
          },
          "maxItems": 8,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "WorkingMapCandidate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assistant_text": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Assistant Text",
      "type": "string"
    },
    "source_refs": {
      "items": {
        "pattern": "^s[0-9]{1,2}$",
        "type": "string"
      },
      "maxItems": 50,
      "title": "Source Refs",
      "type": "array"
    },
    "goal_suggestion": {
      "anyOf": [
        {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Goal Suggestion"
    },
    "closure": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClosureCandidate"
        },
        {
          "type": "null"
        }
      ]
    },
    "topics": {
      "items": {
        "enum": [
          "work",
          "relationship",
          "sleep",
          "daily_event",
          "decision",
          "self_reflection"
        ],
        "type": "string"
      },
      "maxItems": 5,
      "title": "Topics",
      "type": "array"
    },
    "working_map": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkingMapCandidate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "assistant_text",
    "source_refs",
    "goal_suggestion",
    "closure",
    "topics"
  ],
  "title": "ConversationCandidate",
  "type": "object"
}
